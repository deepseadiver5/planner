<div class="card task mb-3" draggable="true" data-id="<%= task.id %>">
  <div class="card-header d-flex justify-content-between">
    <button class="btn btn-outline-dark btn-sm delete-btn">&#x1F5D1;</button>
    <button class="btn btn-outline-dark btn-sm editbtn">&#8230;</button>
  </div>
  <div class="card-body">
    <h6 class="card-title text-capitalize mb-0 letter-spacing-tight fw-light loose-line">
      <%= task.name %>
    </h6>
  </div>
</div>