<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Amiga Workbench UI</title>
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <style>
    :root {
      --amiga-bg: #2a64a5;
      --amiga-titlebar: #6aaed8;
      --amiga-text: #d0d0d0;
      --amiga-border: #888888;
      --amiga-highlight: #e0e8f0;
      --amiga-dark: #000000;
    }

    body {
      margin: 0;
      background-color: var(--amiga-bg);
      color: var(--amiga-text);
      font-family: 'Share Tech Mono', monospace;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .window {
      width: 320px;
      border: 2px solid var(--amiga-border);
      box-shadow: inset -2px -2px var(--amiga-dark), inset 2px 2px var(--amiga-highlight);
      background-color: var(--amiga-titlebar);
    }

    .titlebar {
      background-color: var(--amiga-border);
      color: var(--amiga-highlight);
      padding: 4px 8px;
      font-weight: bold;
      text-transform: uppercase;
      font-size: 14px;
    }

    .content {
      background-color: var(--amiga-bg);
      padding: 10px;
      height: 200px;
      color: var(--amiga-text);
      font-size: 14px;
    }

    .button-bar {
      display: flex;
      justify-content: end;
      padding: 8px;
      background-color: var(--amiga-titlebar);
    }

    .btn {
      background-color: var(--amiga-border);
      color: var(--amiga-highlight);
      border: 2px solid var(--amiga-dark);
      padding: 4px 12px;
      margin-left: 8px;
      font-family: 'Share Tech Mono', monospace;
      box-shadow: inset -1px -1px var(--amiga-highlight), inset 1px 1px var(--amiga-dark);
      cursor: pointer;
    }

    .btn:hover {
      background-color: var(--amiga-highlight);
      color: var(--amiga-dark);
    }

    .boot-screen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: var(--amiga-bg);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    .boot-icon {
      width: 150px;
      image-rendering: pixelated;
    }
  </style>
</head>
<body>

  <!-- <div class="boot-screen">
    <img class="boot-icon" src="https://upload.wikimedia.org/wikipedia/commons/7/7c/Amiga_insert_disk.png" alt="Insert Disk Icon">
  </div> -->

  <div class="window">
    <div class="titlebar">Workbench</div>
    <div class="content">
      <p>Welcome to the Amiga Workbench.</p>
      <p>This is a retro-themed UI demo.</p>
    </div>
    <div class="button-bar">
      <button class="btn">OK</button>
      <button class="btn">Cancel</button>
    </div>
  </div>

</body>
</html>
