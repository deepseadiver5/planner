<% layout('./layouts/boilerplate') -%>

            <div class="row gx-4">
                <div class="col-6 px-5 column py-3 offset-3">
                    <div class="taskHolder p-3 bg-body-secondary rounded bg-opacity-50">
                        <h4 class="fw-light text-dark letter-spacing-loose">
                            Select a List
                        </h4>
                        <% for (let list of lists) { %>
                            <%- include('../partials/listCard', { list }) %>
                                <% } %>
                                    <button class="btn btn-lg add-new-list fw-light text-dark letter-spacing-tight px-0"
                                        id="createNewListBtn">
                                        + Create a New List
                                    </button>
                    </div>
                </div>
            </div>

            <script src="/crud-buttons-list.js"></script>